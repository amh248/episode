generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  displayName  String?
  bio          String?
  location     String?
  website      String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  watchEntries   WatchEntry[]
  watchlist      WatchlistItem[]
  lists          List[]
  favoriteShows  FavoriteShow[]
  followers      Follow[]       @relation("Following")
  following      Follow[]       @relation("Follower")
  reviewLikes    ReviewLike[]
  listLikes      ListLike[]
}

model WatchEntry {
  id        String    @id @default(cuid())
  userId    String
  tmdbId    Int
  watchedAt DateTime?
  rating    Float?
  review    String?
  liked     Boolean   @default(false)
  tags      String    @default("")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes ReviewLike[]

  @@unique([userId, tmdbId])
  @@index([userId, watchedAt])
  @@index([tmdbId])
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  tmdbId    Int
  addedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId])
}

model List {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  isPublic    Boolean  @default(true)
  isRanked    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ListItem[]
  likes ListLike[]
}

model ListItem {
  id       String  @id @default(cuid())
  listId   String
  tmdbId   Int
  position Int
  note     String?

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, tmdbId])
  @@index([listId, position])
}

model FavoriteShow {
  id       String @id @default(cuid())
  userId   String
  tmdbId   Int
  position Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, position])
  @@unique([userId, tmdbId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model ReviewLike {
  id           String   @id @default(cuid())
  userId       String
  watchEntryId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchEntry WatchEntry @relation(fields: [watchEntryId], references: [id], onDelete: Cascade)

  @@unique([userId, watchEntryId])
}

model ListLike {
  id        String   @id @default(cuid())
  userId    String
  listId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  list List @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([userId, listId])
}
